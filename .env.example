# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Broker backend ---
# mock   : aucun terminal MT5 requis (dev macOS/Linux, CI, tests)
# native : nécessite Windows + terminal MT5 installé et connecté
# bridge : réservé — non implémenté à l'Étape 1
BROKER_BACKEND=mock

# --- MT5 (utilisé seulement si BROKER_BACKEND=native) ---
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_BROKER_TIMEZONE=UTC

# --- Database ---
DATABASE_URL=postgresql+psycopg://atip:atip@localhost:5433/atip

# --- Safety (ne pas modifier à l'Étape 1) ---
TRADING_EXECUTION_ENABLED=false
